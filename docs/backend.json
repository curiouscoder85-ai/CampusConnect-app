{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account on the platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "firstName": {
          "type": "string",
          "description": "User's first name."
        },
        "lastName": {
          "type": "string",
          "description": "User's last name."
        },
        "role": {
          "type": "string",
          "description": "User's role (e.g., student, teacher, admin)."
        }
      },
      "required": [
        "id",
        "email",
        "firstName",
        "lastName",
        "role"
      ]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents a course offered on the platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the course entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the course."
        },
        "description": {
          "type": "string",
          "description": "Description of the course."
        },
        "teacherId": {
          "type": "string",
          "description": "Reference to Teacher. (Relationship: Teacher 1:N Course)"
        },
        "status": {
          "type": "string",
          "description": "Status of course (e.g., draft, published, archived)."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "teacherId",
        "status"
      ]
    },
    "SystemNotification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "System Notification",
      "type": "object",
      "description": "Internal notifications for administrators regarding critical events.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["account_deleted", "course_deleted", "user_left"] },
        "message": { "type": "string" },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "message", "userId", "userName", "createdAt"]
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" }
        }
      },
      {
        "path": "/courses/{courseId}",
        "definition": {
          "entityName": "Course",
          "schema": { "$ref": "#/backend/entities/Course" }
        }
      },
      {
        "path": "/system_notifications/{notificationId}",
        "definition": {
          "entityName": "SystemNotification",
          "schema": { "$ref": "#/backend/entities/SystemNotification" },
          "description": "Admin-only notifications for tracking system-wide events like deletions."
        }
      }
    ]
  }
}